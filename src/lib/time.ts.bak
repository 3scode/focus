import type { Block } from "@/types"

const DAYS = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"]
const DAYS_SHORT = ["Min", "Sen", "Sel", "Rab", "Kam", "Jum", "Sab"]
const MONTHS = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"]
const MONTHS_SHORT = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"]

function p(n: number): string {
  return String(n).padStart(2, "0")
}

export function format(date: Date, pattern: string): string {
  const d = date.getDate()
  const m = date.getMonth()
  const y = date.getFullYear()
  const w = date.getDay()
  const h = date.getHours()
  const min = date.getMinutes()

  const map: Record<string, string> = {
    "yyyy": String(y),
    "MMMM": MONTHS[m],
    "MMM": MONTHS_SHORT[m],
    "MM": p(m + 1),
    "dd": p(d),
    "EEEE": DAYS[w],
    "EEE": DAYS_SHORT[w],
    "HH": p(h),
    "mm": p(min),
    "d": String(d),
  }

  let r = pattern
  for (const [k, v] of Object.entries(map)) {
    r = r.split(k).join(v)
  }
  return r
}

export function formatDate(date: Date): string {
  return format(date, "yyyy-MM-dd")
}

export function formatDisplayDate(date: Date): string {
  return `${DAYS[date.getDay()]}, ${MONTHS[date.getMonth()]} ${date.getDate()}`
}

export function formatTimeRange(start: string, end: string): string {
  return `${start} — ${end}`
}

export function formatDuration(start: string, end: string): string {
  const mins = calcDuration(start, end)
  if (mins < 60) return `${mins}m`
  return `${Math.floor(mins / 60)}h ${mins % 60 > 0 ? `${mins % 60}m` : ""}`.trim()
}

function toMinutes(time: string): number {
  const [h, m] = time.split(":").map(Number)
  return h * 60 + m
}

export function calcDuration(start: string, end: string): number {
  const s = toMinutes(start)
  let e = toMinutes(end)
  if (e <= s) e += 1440
  return e - s
}

export function calcEndTime(start: string, durationMinutes: number): string {
  const [h, m] = start.split(":").map(Number)
  const total = h * 60 + m + durationMinutes
  return `${p(Math.floor(total / 60) % 24)}:${p(total % 60)}`
}

export function generateTimeSlots(start: string, end: string, interval = 60): string[] {
  const slots: string[] = []
  let [h, m] = start.split(":").map(Number)
  const [eh, em] = end.split(":").map(Number)
  const endMins = eh * 60 + em

  while (h * 60 + m < endMins) {
    slots.push(`${p(h)}:${p(m)}`)
    m += interval
    h += Math.floor(m / 60)
    m = m % 60
    h = h % 24
  }
  return slots
}

function getWeekStart(date: Date): Date {
  const d = new Date(date)
  const day = d.getDay()
  const diff = day === 0 ? -6 : 1 - day
  d.setDate(d.getDate() + diff)
  d.setHours(0, 0, 0, 0)
  return d
}

export function getWeekDays(date: Date): Date[] {
  const days: Date[] = []
  const start = getWeekStart(date)
  for (let i = 0; i < 7; i++) {
    const d = new Date(start)
    d.setDate(d.getDate() + i)
    days.push(d)
  }
  return days
}

export function isToday(date: Date): boolean {
  const t = new Date()
  return date.getFullYear() === t.getFullYear() &&
    date.getMonth() === t.getMonth() &&
    date.getDate() === t.getDate()
}

export function checkOverlap(
  startA: string, endA: string,
  startB: string, endB: string
): boolean {
  const aS = toMinutes(startA), bS = toMinutes(startB)
  let aE = toMinutes(endA), bE = toMinutes(endB)
  if (aE <= aS) aE += 1440
  if (bE <= bS) bE += 1440
  return aS < bE && bS < aE
}

export function generateRecurringBlocks(baseBlock: Block): Block[] {
  if (!baseBlock.recurring || !baseBlock.recurringPattern) {
    return [baseBlock]
  }

  const blocks: Block[] = []
  const startDate = new Date(baseBlock.recurringStartDate || baseBlock.date)
  const endDateStr = baseBlock.recurringEndDate
  const endDate = endDateStr ? new Date(endDateStr) : new Date(startDate)
  if (!endDateStr) endDate.setDate(endDate.getDate() + 28)

  const currentDate = new Date(startDate)
  const now = new Date().toISOString()
  let iterations = 0
  const MAX_ITERATIONS = 365

  while (currentDate <= endDate && iterations < MAX_ITERATIONS) {
    const block: Block = {
      ...baseBlock,
      id: crypto.randomUUID(),
      date: formatDate(currentDate),
      focusSessions: [],
      createdAt: now,
      updatedAt: now,
    }
    blocks.push(block)
    iterations++

    if (baseBlock.recurringPattern === "daily") {
      currentDate.setDate(currentDate.getDate() + 1)
    } else if (baseBlock.recurringPattern === "weekly") {
      currentDate.setDate(currentDate.getDate() + 7)
    } else if (baseBlock.recurringPattern === "monthly") {
      currentDate.setMonth(currentDate.getMonth() + 1)
    } else {
      break
    }
  }

  return blocks
}
